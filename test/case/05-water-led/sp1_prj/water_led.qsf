set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE10F17C8
set_global_assignment -name TOP_LEVEL_ENTITY water_led
set_global_assignment -name VERILOG_FILE ../src/sine_quarter_lut.v
set_global_assignment -name VERILOG_FILE ../src/water_led.v
set_global_assignment -name SDC_FILE water_led.sdc

set_location_assignment PIN_E1  -to clk
set_location_assignment PIN_M15 -to rst_n
set_location_assignment PIN_L7  -to led[0]
set_location_assignment PIN_M6  -to led[1]
set_location_assignment PIN_P3  -to led[2]
set_location_assignment PIN_N3  -to led[3]

set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
